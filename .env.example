# MamaDoc Django Front - environment example
#
# Copy this file to .env.local for local development.
# Do not put production credentials here.

# Django API. Keep /api when using the Vite dev proxy below.
VITE_API_URL="/api"

# Local dev proxy target for /api.
# Use http://localhost:8000 when the Django backend is running locally,
# or https://newcrm.pediatr.kg when you want local frontend + dev server backend.
VITE_API_PROXY_TARGET="http://localhost:8000"

# Организация публичной витрины онлайн-записи (/book) по умолчанию: её slug
# в публичном API /api/v1/organizations/<slug>/. Конкретную клинику витрина
# берёт из адреса (/book?org=klinika-21 — так её открывает кнопка «Сайт записи»
# в модуле «Брони»), а эта переменная отвечает только за /book без параметра.
VITE_BOOKING_ORG_SLUG="mama-doktor"

# Боевой адрес витрины для ссылок наружу: QR в подтверждении записи и кнопка
# «Поделиться». Без переменной берётся адрес, с которого открыт фронт, — то есть
# http://localhost:5177 при локальной разработке (телефон такую ссылку не
# откроет) и test.crm.operator.kg с тестового стенда (пациента туда вести
# нельзя). На проде задавать обязательно.
VITE_BOOKING_PUBLIC_ORIGIN="https://newcrm.pediatr.kg"

# Бренд витрины в превью ссылки (мессенджеры читают статический index.html,
# рантайм-теги им не видны — см. комментарий в index.html):
#   VITE_BOOKING_ORG_NAME — название клиники в og:title/og:site_name.
# Логотип и иконка вкладки берутся из публичного API организации, а пока он их
# не отдаёт — из этих файлов (только для организации по умолчанию):
#   VITE_BOOKING_LOGO_URL — логотип для превью ссылки (квадратный, от 600 px).
#   VITE_BOOKING_ICON_URL — знак для иконки вкладки и шапки витрины.
VITE_BOOKING_ORG_NAME="Мама Доктор"
VITE_BOOKING_LOGO_URL="/og-image.png"
VITE_BOOKING_ICON_URL="/booking-icon.png"

# Optional local settings
VITE_OFFICE_IP=""

# Подсказки адресов при вводе (форма пациента).
# Рекомендуемый вариант: Geoapify — бесплатный тариф 3000 запросов/день,
# регистрация без банковской карты. Ограничьте ключ по origin в кабинете.
# Получить ключ: https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=""

# Альтернатива для собственного Nominatim-сервиса. Публичный
# nominatim.openstreetmap.org для autocomplete запрещён политикой сервиса.
#   VITE_OSM_NOMINATIM_URL — базовый URL self-hosted Nominatim.
#   VITE_OSM_COUNTRYCODES  — ISO-коды стран через запятую (по умолч. "kg";
#                            пусто = без ограничения).
#   VITE_OSM_LANG          — язык подписей (по умолч. "ru").
#   VITE_OSM_VIEWBOX       — "lonMin,latMin,lonMax,latMax" приоритет области.
#   VITE_OSM_EMAIL         — контактный email (вежливость к Nominatim).
VITE_OSM_NOMINATIM_URL=""
VITE_OSM_COUNTRYCODES="kg"
VITE_OSM_LANG="ru"
VITE_OSM_VIEWBOX=""
VITE_OSM_EMAIL=""
